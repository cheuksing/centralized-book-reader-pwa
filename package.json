{
  "name": "pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge:check": "rm -rf .tmp/userscript-bridge && tsc --ignoreConfig --target es2023 --module nodenext --moduleResolution nodenext --outDir .tmp/userscript-bridge src/services/userscript-bridge.check.ts && node .tmp/userscript-bridge/userscript-bridge.check.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@tanstack/react-virtual": "^3.14.13",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxdb": "^17.5.0",
    "vite-plugin-pwa": "^1.3.0",
    "wouter": "^3.11.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sass": "^1.104.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-tsconfig-paths": "^6.1.1"
  }
